# Run scaffolding for Codex campaigns: goals, launch messages and run reports.
# Gitignored as a DIRECTORY (not a filename pattern) so a new artefact type
# cannot leak by being named something a pattern did not anticipate.
codex/

# Claude Code repo-local config. `settings.json` and `hooks/` ARE tracked — they
# enforce the Backlog.md rules (bare --notes/--plan replaces a section silently;
# hand-edited task markdown loses one at exit 0) for anyone working in this repo.
# Everything else under .claude/ is per-machine state: worktrees, scheduler locks,
# and settings.local.json.
.claude/*
!.claude/settings.json
!.claude/hooks/

# Build output
/bin/
/dist/
*.exe

# Go
vendor/
*.test
*.out
coverage.*
.tools/
__pycache__/
*.py[cod]

# Local config with real endpoints/credentials
config.local.yaml
config.yaml
.env

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# stray root build output
/rfc6035-2otel
