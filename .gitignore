# Run scaffolding for Codex campaigns: goals, launch messages and run reports.
# Gitignored as a DIRECTORY (not a filename pattern) so a new artefact type
# cannot leak by being named something a pattern did not anticipate.
codex/

# Claude Code repo-local config. The contributor kit's `.claude/skills/` links are tracked.
.claude/*
!.claude/skills/

# Build output
/bin/
/dist/
*.exe

# Go
vendor/
*.test
*.out
coverage.*
.tools/
__pycache__/
*.py[cod]

# Local config with real endpoints/credentials
config.local.yaml
config.yaml
.env

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# stray root build output
/rfc6035-2otel

# Machine-local agent artefacts, never committed
docs/superpowers/

# loop-pi (pi-subagents writes .pi/subagents/)
.pi/
